# ============================================================
# 轻语（QingYu Care）环境变量模板
#
#   cp .env.example .env   然后填入真实值
#
# .env 已在 .gitignore 中，不会被提交。
# 本地开发只需要 DASHSCOPE_API_KEY 一项，其余留空即用代码内默认值；
# 生产用 docker/docker-compose.prod.yml 时下面各项都要认真填。
#
# ⚠️ 所有写着 change-me-in-production 的值都必须改成随机值（如 `openssl rand -base64 24`）。
# 后端在非 dev/test profile 下发现任一密钥仍含 change-me 会拒绝启动，并在日志里列出是哪几个变量。
# ============================================================

# ---------- 运行模式 ----------

# 激活的 Spring profile（逗号分隔）。留空即基线配置，生产就留空。
#
# 演示环境填 demo：DemoDataSeeder 播种「云舟科技」整套演示数据（租户/应用/用户、
# 知识库 4 篇文档、8 条 QA、12 组会话、30 天用量与分析日表），演示账号
# demo_admin / demo123456（租户管理员）与 demo_agent / demo123456（坐席）。
# 播种走真实 uploadDocument()，需要 DASHSCOPE_API_KEY 真实可用才能嵌入成功。
# 幂等键是租户 code demo-cloudboat，重启不重播。
#
# ⚠️ 演示环境不要填 dev。dev 会打开 Swagger、把 org.springframework.ai 调到 DEBUG
# （完整 prompt 写进日志），并放开模型端点与 MCP 指向内网。demo 不依赖 dev。
SPRING_PROFILES_ACTIVE=

# ---------- AI 模型（必填） ----------
#
# ⚠️ 下面的模型配置只用于【首次启动播种】：首启时各播一条平台共享的对话模型与向量模型，
# 之后一律以后台「共享模型 / 模型配置」为准，改这里不会影响已有数据。
# 向量模型绑在应用上：新应用钉住平台默认向量模型，各应用可在「知识库」页自行切换。

# 通义千问 DashScope API Key，控制台：https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=sk-your-dashscope-api-key

# ⚠️ base-url 必须自带 /v1
# Spring AI 2.0 起改用官方 openai-java SDK，只往 baseUrl 后拼 chat/completions
# 与 embeddings，不再补 /v1（1.x 的 OpenAiApi 拼的是 /v1/xxx，契约已翻转）。
# 缺 /v1 会让对话、文档摄取、知识检索全线 404。
# 换任意 OpenAI 兼容端点同理，一律带 /v1。
AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

AI_CHAT_MODEL=qwen3.7-flash-2026-07-15
AI_EMBEDDING_MODEL=qwen3.7-text-embedding
# 向量模型用别家时单独设端点与 Key（留空则沿用上面对话那一份）
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_API_KEY=

# ⚠️ 平台统一的向量维度（vector_store 的列维度）。后台添加向量模型时会真实调用一次，
# 返回维度不等于它就拒绝保存，所以这里定的是「平台接受哪些模型」，不是跟着某个模型走。
# 维度不能对已有库热切换：启动时会校验列维度，对不上直接拒绝启动。上线前定好，别再动。
AI_EMBEDDING_DIMENSIONS=1024

# ---------- 数据库 ----------

# 供 postgres 容器初始化用
POSTGRES_DB=qingyu_care
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production

# 供后端连接用（Spring relaxed binding 覆盖 application.yml 里的 spring.datasource.*）
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/qingyu_care
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-in-production

# ---------- Redis ----------
# 用途：限流、Webhook 投递队列（Redis Stream）、多实例实时通道 pub/sub
REDIS_HOST=redis
REDIS_PORT=6379
# 生产必填：docker-compose.prod.yml 用它给 Redis 配 requirepass，后端同时用它连接。
# 本地开发（docker/docker-compose.yml 的 Redis 无密码）留空即可。
REDIS_PASSWORD=change-me-in-production

# ---------- 对象存储（RustFS，S3 兼容） ----------
# 存知识库上传的原始文件与聊天附件。桶必须是私有的——附件一律经带鉴权的
# 代理端点下发，不直接暴露对象 URL。
STORAGE_ACCESS_KEY=rustfsadmin
STORAGE_SECRET_KEY=change-me-in-production
STORAGE_ENDPOINT=http://rustfs:9000
STORAGE_BUCKET=qingyu-care

# ---------- 平台管理员 ----------

# 首启创建的平台管理员 admin 的初始口令。留空则随机生成并只在启动日志里打印一次。
# ⚠️ 别保留模板值：照模板部署的实例用 admin / change-me-in-production 就能登录（后端会拒绝启动）。
QINGYU_ADMIN_INITIAL_PASSWORD=change-me-in-production

# 是否开放登录页自助注册（注册即新建一个租户）。系统没有邮件/短信验证，生产保持 false，
# 租户由平台管理员在后台创建；平台管理员在「平台配置 → 开放注册」里设置过的话以那里为准。
SELF_REGISTER_ENABLED=false

# 管理端允许的跨域来源（逗号分隔）。前端与后端同源部署时留空。
CORS_ALLOWED_ORIGINS=

# 是否允许模型 endpoint 指向内网/环回。生产保持 false；只有本机跑 Ollama 等自托管模型时才 true。
MODEL_ALLOW_PRIVATE_ENDPOINTS=false

# 是否允许 MCP server 指向内网/环回。生产保持 false；只有接本地自建 MCP server 时才 true。
MCP_ALLOW_PRIVATE_SERVERS=false

# ---------- 可选开关 ----------

# 结构化卡片（生成式 UI）：关掉后 LLM 不再被注入卡片能力 Prompt，只回纯文本
CARDS_ENABLED=true

# 多实例实时通道：单实例部署可关掉，DB 仍是事实源，只是少了跨实例的 SSE 加速
REALTIME_REDIS_ENABLED=true

# ---------- 端口（仅 docker-compose.prod.yml 使用） ----------
FRONTEND_PORT=80
