{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "../widget/src/core/**/*.ts"],
  "exclude": ["**/*.test.ts", "../widget/src/core/**/*.test.ts"]
}
